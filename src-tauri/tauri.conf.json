{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Title Word",
  "version": "0.1.1",
  "identifier": "com.titleword.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "Title Word",
        "width": 900,
        "height": 800,
        "minWidth": 700,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}